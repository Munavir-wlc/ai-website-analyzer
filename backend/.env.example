PORT=4000
FRONTEND_URL=http://localhost:3000

# Default public-safe behavior: deterministic/passive checks only.
ENABLE_ACTIVE_SCANS=false
ENABLE_LOAD_TESTING=false
ENABLE_ZAP_SCANS=false
ENABLE_AUTHENTICATED_SCANS=false
ENABLE_AI_FINDINGS=false

# Optional services.
ZAP_URL=http://localhost:8090
ZAP_API_KEY=
OPENAI_API_KEY=

# Runtime storage.
REPORT_TTL_MS=86400000
SCAN_QUEUE_MAX=25

# Database and Authentication
MONGODB_URI=mongodb://localhost:27017/ai-website-analyzer
JWT_SECRET=your_jwt_secret_key_here

# Sentry Error & Performance Tracking (Optional)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Commercial Payments & Subscriptions (Feature Flag)
ENABLE_PAYMENTS=false
STRIPE_PRICE_PRO=price_1U4LuKRg3ycooQUfV1g8VMcE
STRIPE_PRICE_TEAM=price_1U4LwERg3ycooQUfFXNcz2bZ
STRIPE_PRO_PRICE_ID=price_1U4LuKRg3ycooQUfV1g8VMcE
STRIPE_TEAM_PRICE_ID=price_1U4LwERg3ycooQUfFXNcz2bZ
STRIPE_SECRET_KEY=sk_test_example_key
STRIPE_WEBHOOK_SECRET=whsec_example_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_example_key

# Email Sending Service (SMTP / SendGrid / Mailgun / AWS SES)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="AI Website Security" <noreply@vapt-analyzer.com>

# Example local development values (do not commit real secrets)
# MONGODB_URI=mongodb://localhost:27017/ai-website-analyzer
# PUPPETEER_ALLOW_NO_SANDBOX=false
# ENABLE_ZAP_SCANS=false

